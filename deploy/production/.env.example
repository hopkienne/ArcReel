# Cấu hình môi trường production của ArcReel (PostgreSQL)
# Sao chép thành .env rồi điền giá trị của bạn

# ============================================================
# Cấu hình xác thực (Authentication)
# ============================================================
# Tên đăng nhập (mặc định: admin)
AUTH_USERNAME=admin
# Mật khẩu đăng nhập (để trống sẽ tự sinh ở lần khởi động đầu và ghi lại vào .env)
AUTH_PASSWORD=
# Khóa ký JWT (để trống sẽ tự sinh, nhưng token sẽ hết hiệu lực sau khi khởi động lại)
AUTH_TOKEN_SECRET=

# ============================================================
# Cấu hình PostgreSQL
# ============================================================
# Mật khẩu cơ sở dữ liệu (bắt buộc, docker-compose sẽ kiểm tra khi khởi động)
# Chỉ dùng chữ và số để tránh ký tự đặc biệt trong URL (@#/?%...) làm lỗi phân tích DATABASE_URL
# Cách tạo: openssl rand -hex 16
POSTGRES_PASSWORD=

# ============================================================
# Cấu hình nhật ký (Logging)
# ============================================================
# Mức log (mặc định: INFO, tùy chọn: DEBUG, WARNING, ERROR)
# LOG_LEVEL=INFO
