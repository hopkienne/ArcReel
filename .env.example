# ArcReel Generator Environment Configuration
# Copy this file to .env and fill in your values
#
# Hầu hết cấu hình (API Key, chọn backend, giới hạn tốc độ, chọn model, ...)
# đã được chuyển sang trang cấu hình WebUI (/settings), chỉ cần cấu hình trên trang sau lần khởi động đầu.
# Tệp này chỉ giữ các cấu hình mức khởi động/hạ tầng.

# ============================================================
# Cấu hình xác thực (Authentication)
# ============================================================
# Tên đăng nhập (mặc định: admin)
AUTH_USERNAME=admin
# Mật khẩu đăng nhập (để trống sẽ tự sinh ở lần khởi động đầu và ghi lại vào tệp này)
AUTH_PASSWORD=
# Khóa ký JWT (để trống sẽ tự sinh, nhưng token sẽ hết hiệu lực sau khi khởi động lại)
AUTH_TOKEN_SECRET=

# ============================================================
# Cấu hình cơ sở dữ liệu (Database Configuration)
# ============================================================
# Mặc định dùng SQLite (phát triển/máy đơn)
# SQLite:     sqlite+aiosqlite:///./projects/.arcreel.db
# PostgreSQL: postgresql+asyncpg://user:pass@host:5432/arcreel
# DATABASE_URL=sqlite+aiosqlite:///./projects/.arcreel.db

# ============================================================
# Cấu hình nhật ký (Logging)
# ============================================================
# Mức log (mặc định: INFO, tùy chọn: DEBUG, WARNING, ERROR)
# LOG_LEVEL=INFO

# ============================================================
# Nhà cung cấp video (Video Provider)
# ============================================================
# DEFAULT_VIDEO_PROVIDER=gemini     # Nhà cung cấp video mặc định toàn cục (gemini | seedance)

# ============================================================
# Cấu hình Seedance (Volcano Ark)
# ============================================================
# ARK_API_KEY=                      # API key của Volcano Ark
# FILE_SERVICE_BASE_URL=            # URL công khai của dịch vụ tệp dự án (upload ảnh Seedance cần truy cập công khai)
